config RTL8822BU
	tristate "Realtek RTL8812BU/RTL8822BU USB WiFi (RinCat vendor driver)"
	depends on USB && CFG80211
	select WIRELESS_EXT
	select WEXT_PRIV
	help
	  Out-of-tree driver from
	  https://github.com/RinCat/RTL88x2BU-Linux-Driver (master) for Realtek
	  RTL8812BU / RTL8822BU 802.11ac USB adapters. It supports monitor mode
	  and frame injection.
